---
import Base from '../layouts/Base.astro';
import { site, stats, categories, projects, process, experience, tools } from '../data/site.js';

const count = (id) => (id === 'all' ? projects.length : projects.filter((p) => p.cats.includes(id)).length);
const hexToRgb = (h) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16)).join(',');

// process arc: cubic bezier in a 1200 x 460 box
const P = [[0, 440], [300, -10], [900, -10], [1200, 440]];
const bez = (t) => {
  const u = 1 - t;
  const x = u ** 3 * P[0][0] + 3 * u * u * t * P[1][0] + 3 * u * t * t * P[2][0] + t ** 3 * P[3][0];
  const y = u ** 3 * P[0][1] + 3 * u * u * t * P[1][1] + 3 * u * t * t * P[2][1] + t ** 3 * P[3][1];
  return [x, y];
};
const ts = [0.07, 0.285, 0.5, 0.715, 0.93];
const arcD = `M ${P[0]} C ${P[1]} ${P[2]} ${P[3]}`;
const marquee = ['Web apps', 'Mobile apps', 'SaaS dashboards', 'AI & LLM interfaces', 'Design systems', 'UX research', 'Landing pages', 'Arabic-first products'];
const particles = Array.from({ length: 26 }, (_, i) => ({
  x: (i * 37.7) % 100, y: (i * 23.3) % 70, s: i % 5 === 0 ? 3 : 2, t: 3 + (i % 5), d: (i % 7) * 0.6,
}));
---
<Base>
  <!-- ============ HERO ============ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-light" aria-hidden="true">
      <div class="corner"></div>
      <div class="halo"></div>
      <div class="horizon" data-hz><i></i></div>
      <div class="beam"></div>
      <div class="pts">{particles.map((p) => <i style={`--x:${p.x}%;--y:${p.y}%;--s:${p.s}px;--t:${p.t}s;--dl:${p.d}s`}></i>)}</div>
    </div>
    <div class="mglow" aria-hidden="true"></div>

    <div class="wrap hero-copy">
      <span class="label ok" data-reveal style="--d:150"><span data-type data-delay="900">{site.available ? 'Open to new opportunities' : 'Currently busy'}</span></span>
      <h1 id="hero-title" class="h1 split grad" style="--sd:300ms">Designing calm, clear products people <span class="acc">love</span> to use.</h1>
      <p class="lead" data-reveal style="--d:950">I’m Abdul Rahman — a UI/UX &amp; product designer crafting web apps, mobile apps, SaaS dashboards and AI interfaces, from the first research question to the final pixel.</p>
      <div class="ctas" data-reveal style="--d:1120">
        <a class="btn btn-p mag" href="#work">View selected work <span class="arr">→</span></a>
        <a class="btn btn-g mag" href={site.cv} download>Download CV</a>
      </div>
      <p class="proof" data-reveal style="--d:1280"><span>{site.location}</span><i></i><span>~3 years experience</span><i></i><span>Web · Mobile · SaaS · AI</span></p>
    </div>

    <div class="stage" data-tilt>
      <svg class="orbits" viewBox="0 0 1800 640" aria-hidden="true" preserveAspectRatio="none">
        <ellipse cx="900" cy="300" rx="760" ry="250" />
        <ellipse cx="900" cy="300" rx="890" ry="310" />
      </svg>
      <div class="ug" aria-hidden="true"></div>
      <div class="fan">
        <img class="shot s1" src="/work/cover-hotello.webp" alt="" width="808" height="632" />
        <img class="shot s3" src="/work/cover-ai-analyst.webp" alt="" width="808" height="632" />
        <img class="shot s2" src="/work/cover-mushaf.webp" alt="Mushaf Eqraa — Quran web platform case study cover" width="808" height="632" fetchpriority="high" />
      </div>
      <div class="chip c1" data-dep="18"><div class="glass bob"><span class="ic" style="--c:#7C6CFF">✦</span><div><b>Case studies</b><small>Full process on Behance</small></div></div></div>
      <div class="chip c2" data-dep="24"><div class="glass bob"><span class="ic" style="--c:#FFB547">ع</span><div><b>Arabic-first</b><small>RTL · LTR products</small></div></div></div>
      <div class="chip c3" data-dep="14"><div class="glass bob"><span class="ic" style="--c:#5EC8FF">◆</span><div><b>Design systems</b><small>Tokens · components</small></div></div></div>
      <div class="chip c4" data-dep="20"><div class="glass bob"><span class="ic" style="--c:#3DDC97">◎</span><div><b>AI interfaces</b><small>LLM &amp; agent UX</small></div></div></div>
    </div>
  </section>

  <!-- ============ MARQUEE ============ -->
  <section class="mq-sec" aria-label="What I design">
    <div class="seam"></div>
    <p class="eyebrow mq-l">What I design</p>
    <div class="mq">
      <div class="mq-t">
        {[0, 1].map(() => (
          <div class="mq-g" aria-hidden="true">{marquee.map((m) => <><span class={m.startsWith('AI') ? 'hl' : ''}>{m}</span><em>✦</em></>)}</div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ STATS ============ -->
  <section class="sec stats-sec" aria-labelledby="stats-title">
    <div class="blob" style="--o:.16;width:900px;height:360px;left:50%;top:44%;translate:-50% 0"></div>
    <div class="wrap">
      <div class="sh">
        <p class="eyebrow" data-reveal>By the numbers</p>
        <h2 id="stats-title" class="h2 split grad">Three years in, still obsessed with the <span class="acc">details.</span></h2>
      </div>
      <div class="stats">
        {stats.map((s, i) => (
          <div class={`stat ${s.hot ? 'hot' : ''}`} data-count={s.value} data-reveal style={`--d:${i * 120}`}>
            <p class="big"><span class="n">{s.value}</span><span class="suf">{s.suffix}</span></p>
            <p class="sl">{s.label}</p>
            <p class="ss">{s.sub}</p>
            <p class="sn mono">{s.note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ WORK ============ -->
  <section id="work" class="sec work" aria-labelledby="work-title">
    <div class="blob" style="--o:.12;width:900px;height:500px;left:-300px;top:30%"></div>
    <div class="wrap">
      <div class="sh">
        <span class="label" data-reveal>Selected work</span>
        <h2 id="work-title" class="h2 split grad">Selected work that shows the <span class="acc">thinking</span></h2>
        <p class="lead" data-reveal>Each project walks from research and flows to the final UI — the decisions are the point.</p>
      </div>

      <div class="filter-row" data-reveal>
        <div class="tabs" role="tablist" aria-label="Filter projects" data-tabs>
          <span class="pill" aria-hidden="true"></span>
          {categories.map((c, i) => (
            <button role="tab" data-cat={c.id} aria-selected={i === 0 ? 'true' : 'false'}>{c.label}<em>{count(c.id)}</em></button>
          ))}
        </div>
        <a class="be-btn" href={site.behance} target="_blank" rel="noopener">
          <span class="be-l"><b>Bē</b> Behance</span>
          <span class="be-c" aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="work-grid" data-filter="all">
        {projects.map((p, i) => {
          const Tag = p.href ? 'a' : 'div';
          const ext = p.href?.startsWith('http');
          return (
            <Tag
              class={`work-card card spot ${p.size}`}
              data-cats={p.cats.join(' ')}
              href={p.href || undefined}
              target={ext ? '_blank' : undefined}
              rel={ext ? 'noopener' : undefined}
              style={`--ca:${hexToRgb(p.accent)};--d:${(i % 2) * 120}`}
              data-reveal
            >
              <div class="wc-img">
                <img src={p.cover} alt={`${p.title} cover`} loading="lazy" width="808" height="632" />
                <span class={`type ${p.type === 'Case study' ? 'cs' : 'lp'}`}>{p.type}</span>
              </div>
              <div class="wc-body">
                <ul class="wc-tags">{p.tags.map((t) => <li class="tag">{t}</li>)}</ul>
                <div class="wc-title"><h3>{p.title}</h3><span class="wc-arr" aria-hidden="true">{p.href ? '↗' : 'Soon'}</span></div>
                <p>{p.desc}</p>
              </div>
            </Tag>
          );
        })}
        <a class="see-all card spot" href={site.behance} target="_blank" rel="noopener" data-cats="case web app" data-reveal>
          <span>See all work on Behance</span><span class="arr">↗</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ ABOUT ============ -->
  <section id="about" class="sec about" aria-labelledby="about-title">
    <div class="seam"></div>
    <div class="wrap">
      <div class="sh">
        <span class="label" data-reveal>About</span>
        <h2 id="about-title" class="h2 split grad">A designer who <span class="acc">listens</span> first.</h2>
        <p class="lead" data-reveal>I care about the moment a product finally makes sense to someone — that’s what I design for.</p>
      </div>
      <div class="bento">
        <div class="card portrait" data-reveal>
          <div class="blob" style="--o:.35;width:460px;height:300px;left:60px;top:-180px"></div>
          <div class="avatar">
            <div class="ring"><img src="/me.webp" alt={site.fullName} width="760" height="977" loading="lazy" decoding="async" /></div>
            <div class="orbit-ring back" aria-hidden="true"></div>
            <div class="orbit-ring front" aria-hidden="true"><i></i></div>
            <div class="pop" aria-hidden="true"><img src="/me.webp" alt="" width="760" height="977" loading="lazy" decoding="async" /></div>
          </div>
          <div class="who glass"><b>{site.fullName}</b><small>{site.role}</small></div>
        </div>
        <div class="card intro" data-reveal style="--d:120">
          <div class="blob" style="--o:.22;width:460px;height:300px;right:-120px;top:-150px"></div>
          <p class="eyebrow">Hello</p>
          <p class="big-p">I’m a UI/UX and product designer based in Sharjah. For around three years I’ve designed web apps, mobile apps, SaaS dashboards and AI-powered interfaces — most recently as a UI/UX designer at Misraj Technology, and before that as a freelancer and graphic designer.</p>
          <p class="small-p">I work across the whole process: research, flows, wireframes, UI, design systems and design QA on the real build.</p>
          <div class="mini-stats">
            <div><b class="acc">~3</b><span>years designing</span></div>
            <div><b>5</b><span>stage process</span></div>
            <div><b>AR · EN</b><span>languages</span></div>
          </div>
        </div>
        <div class="card loc" data-reveal>
          <p class="eyebrow">Based in</p>
          <h3>{site.location}</h3>
          <p class="sub">Working remotely across the GCC</p>
          <div class="dots" aria-hidden="true">{Array.from({ length: 126 }, (_, i) => <i class={Math.hypot((i % 18) - 12, Math.floor(i / 18) - 3) < 3.2 ? 'near' : ''}></i>)}<b class="ping"></b></div>
        </div>
        <div class="card edu" data-reveal style="--d:120">
          <p class="eyebrow">Learning</p>
          <ul>
            <li><span class="ei">◐</span><div><b>BSc Data Science</b><small>IU International University · in progress</small></div></li>
            <li><span class="ei">✓</span><div><b>Professional Diploma in UX Design</b><small>UX Design Institute</small></div></li>
          </ul>
        </div>
        <div class="card kit" data-reveal style="--d:240">
          <p class="eyebrow">Toolkit</p>
          <h3>Design → prototype → code</h3>
          <ul class="tools">{tools.map((t) => <li><span style={`--f1:${t.from};--f2:${t.to}`}>{t.glyph}</span><small>{t.name}</small></li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PROCESS ============ -->
  <section id="process" class="sec process" aria-labelledby="process-title">
    <div class="seam"></div>
    <div class="wrap">
      <div class="sh">
        <span class="label" data-reveal>How I work</span>
        <h2 id="process-title" class="h2 split grad">From a fuzzy problem to a <span class="acc">clear</span> product.</h2>
      </div>
      <div class="arc-wrap" data-arc>
        <div class="planet" aria-hidden="true"></div>
        <svg class="arc" viewBox="0 0 1200 460" aria-hidden="true">
          <defs><linearGradient id="arcG" x1="0" x2="1"><stop offset="0" stop-color="#7C6CFF" stop-opacity=".3" /><stop offset=".5" stop-color="#E4E0FF" /><stop offset="1" stop-color="#7C6CFF" /></linearGradient></defs>
          <path class="base" d={arcD} />
          <path class="draw" d={arcD} />
        </svg>
        <ol class="steps">
          {process.map((s, i) => {
            const [x, y] = bez(ts[i]);
            return (
              <li class={`step ${s.hot ? 'hot' : ''}`} data-t={ts[i]} style={`--x:${(x / 1200) * 100}%;--y:${(y / 460) * 100}%`}>
                <span class="node">{s.n}</span>
                <div class="scard glass">
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                  <div class="chips">{s.chips.map((c) => <span>{c}</span>)}</div>
                </div>
              </li>
            );
          })}
        </ol>
      </div>
    </div>
  </section>

  <!-- ============ EXPERIENCE ============ -->
  <section id="experience" class="sec exp" aria-labelledby="exp-title">
    <div class="seam"></div>
    <div class="wrap narrow">
      <div class="sh">
        <span class="label" data-reveal>Experience</span>
        <h2 id="exp-title" class="h2 split grad">Where I’ve <span class="acc">grown</span> so far.</h2>
      </div>
      <ol class="timeline" data-timeline>
        {experience.map((e, i) => (
          <li class={`job card ${e.current ? 'on' : ''}`} data-reveal style={`--d:${i * 100}`}>
            <div class="j-l"><p class="mono">{e.period}</p>{e.current && <span class="label ok">Most recent</span>}</div>
            <div class="j-r">
              <h3>{e.role}</h3>
              <p class="co">{e.company}</p>
              <p class="tx">{e.text}</p>
              <ul class="wc-tags">{e.tags.map((t) => <li class="tag">{t}</li>)}</ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ CONTACT ============ -->
  <section id="contact" class="sec" aria-labelledby="cta-title">
    <div class="wrap">
      <div class="cta" data-reveal>
        <div class="grid-bg" aria-hidden="true"></div>
        <div class="cone" aria-hidden="true"></div>
        <div class="rings" aria-hidden="true"><i style="--w:1100px;--h:260px;--o:.5;--d:40s"></i><i style="--w:820px;--h:190px;--o:.35;--d:30s"></i><i style="--w:560px;--h:130px;--o:.25;--d:22s"></i></div>
        <span class="label ok">Contact</span>
        <h2 id="cta-title" class="h1 grad">Let’s build something <span class="acc">calm</span> together.</h2>
        <p class="lead">Open to full-time roles and freelance projects. Tell me about your product — I usually reply within a day.</p>
        <div class="ctas">
          <a class="btn btn-p" href={`mailto:${site.email}`}>Email me <span class="arr">→</span></a>
          <a class="btn btn-g" href={site.behance} target="_blank" rel="noopener">Behance ↗</a>
          <a class="btn btn-g" href={site.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- hero ---------- */
  .hero { position: relative; padding-top: clamp(150px, 18vw, 230px); text-align: center; overflow: clip; overflow-clip-margin: 0; }
  .hero-light { position: absolute; inset: 0 0 auto; height: 1400px; overflow: hidden; pointer-events: none; }
  .corner { position: absolute; left: -180px; top: -180px; width: 620px; height: 480px; background: radial-gradient(closest-side, rgba(185, 176, 255, 0.18), transparent); animation: breathe 7s ease-in-out infinite; }
  .halo { position: absolute; left: 50%; top: -40px; width: min(1300px, 140vw); height: 420px; transform: translateX(-50%); background: radial-gradient(closest-side, rgba(124, 108, 255, 0.36), transparent); animation: breathe 6s ease-in-out infinite; }
  .horizon { position: absolute; inset: 0; transform: translateY(var(--hzy, 0px)); will-change: transform; -webkit-mask-image: linear-gradient(180deg, #000 0, #000 32%, transparent 60%); mask-image: linear-gradient(180deg, #000 0, #000 32%, transparent 60%); }
  .horizon i { position: absolute; left: 50%; top: 150px; width: max(1700px, 130vw); aspect-ratio: 1; border-radius: 50%; transform: translateX(-50%); background: linear-gradient(180deg, #1a1550, #0c0b22 5%, var(--bg) 16%); box-shadow: 0 0 0 1.5px rgba(228, 224, 255, 0.95), 0 0 56px 6px rgba(124, 108, 255, 0.75), inset 0 40px 90px rgba(124, 108, 255, 0.4); }
  :global(.js) .horizon i { animation: hzIn 2.2s var(--ease) 0.25s both; }
  @keyframes hzIn { from { opacity: 0; transform: translateX(-50%) translateY(260px); } }
  .beam { position: absolute; left: 50%; top: 40px; width: 240px; height: 700px; transform: translateX(-50%); background: radial-gradient(closest-side, rgba(255, 255, 255, 0.08), transparent); }
  .pts i { position: absolute; left: var(--x); top: var(--y); width: var(--s); height: var(--s); border-radius: 50%; background: var(--core); box-shadow: 0 0 8px var(--acc); animation: twinkle var(--t) ease-in-out var(--dl) infinite; }
  .mglow { position: absolute; left: 0; top: 0; width: 640px; height: 640px; margin: -320px 0 0 -320px; border-radius: 50%; pointer-events: none; background: radial-gradient(closest-side, rgba(124, 108, 255, 0.12), transparent); transition: transform 0.6s var(--ease); z-index: 0; }
  .hero-copy { position: relative; z-index: 2; display: grid; justify-items: center; gap: 26px; max-width: 1100px; }
  .hero-copy .lead { max-width: 660px; }
  .ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .proof { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 14px; font-size: 14px; color: var(--faint); }
  .proof i { width: 4px; height: 4px; border-radius: 50%; background: rgba(185, 176, 255, 0.6); }

  .stage { position: relative; margin-top: clamp(60px, 8vw, 90px); height: clamp(340px, 42vw, 560px); perspective: 1800px; }
  .orbits { position: absolute; left: 50%; top: -40px; width: max(1700px, 125vw); height: 640px; transform: translateX(-50%); overflow: visible; pointer-events: none; }
  .orbits ellipse { fill: none; stroke: rgba(185, 176, 255, 0.45); stroke-width: 1.2; filter: drop-shadow(0 0 6px rgba(124, 108, 255, 0.8)); }
  .orbits ellipse + ellipse { stroke: rgba(185, 176, 255, 0.25); }
  .ug { position: absolute; left: 50%; top: -30px; width: min(1000px, 90vw); height: 300px; transform: translateX(-50%); background: radial-gradient(closest-side, rgba(124, 108, 255, 0.45), transparent); pointer-events: none; }
  .fan { position: relative; height: 100%; transform: rotateX(var(--tilt, 18deg)) scale(var(--ts, 0.94)); transform-origin: 50% 0; will-change: transform; }
  .shot { position: absolute; top: 0; left: 50%; width: min(620px, 52vw); border-radius: 20px; border: 1px solid rgba(255, 255, 255, 0.14); box-shadow: 0 40px 90px rgba(0, 0, 0, 0.7), 0 0 70px rgba(124, 108, 255, 0.18); }
  .shot.s1, .shot.s3 { width: min(470px, 38vw); top: 8%; }
  .shot.s1 { transform: translateX(-118%) rotate(-7deg); }
  .shot.s3 { transform: translateX(18%) rotate(7deg); }
  .shot.s2 { transform: translateX(-50%); border-color: rgba(185, 176, 255, 0.45); box-shadow: 0 40px 90px rgba(0, 0, 0, 0.7), 0 0 90px rgba(124, 108, 255, 0.35); }
  .stage::after { content: ''; position: absolute; left: 50%; bottom: -2px; width: 100vw; height: 55%; transform: translateX(-50%); background: linear-gradient(180deg, rgba(5, 6, 10, 0), var(--bg) 82%); z-index: 4; pointer-events: none; }
  .chip { position: absolute; z-index: 5; transition: transform 1s var(--ease); }
  .chip .glass { display: flex; align-items: center; gap: 10px; padding: 12px 16px 12px 12px; border-radius: 16px; text-align: left; animation: bob 7s ease-in-out infinite alternate; }
  .chip b { display: block; font-size: 13px; font-weight: 500; }
  .chip small { display: block; font-size: 11px; color: var(--faint); }
  .chip .ic { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 9px; font-size: 14px; font-weight: 600; color: #fff; background: linear-gradient(180deg, var(--c), color-mix(in srgb, var(--c) 45%, transparent)); box-shadow: 0 0 12px color-mix(in srgb, var(--c) 40%, transparent), inset 0 1px 0 rgba(255, 255, 255, 0.4); }
  :global(.js) .chip { animation: chipIn 1.2s var(--ease) both; animation-delay: calc(1.5s + var(--k, 0) * 0.15s); }
  @keyframes chipIn { from { opacity: 0; translate: 0 40px; scale: 0.9; } }
  .c2 { --k: 1; } .c3 { --k: 2; } .c4 { --k: 3; }
  .c1 { left: clamp(8px, 7vw, 120px); top: 10%; rotate: 3deg; }
  .c2 { left: clamp(8px, 5vw, 90px); top: 56%; rotate: -2.5deg; }
  .c2 .glass { animation-duration: 8.5s; animation-delay: -3s; }
  .c3 { right: clamp(8px, 9vw, 150px); top: 4%; rotate: -3deg; }
  .c3 .glass { animation-duration: 6.5s; animation-delay: -1.2s; }
  .c4 { right: clamp(8px, 7vw, 110px); top: 46%; rotate: 2deg; }
  .c4 .glass { animation-duration: 7.8s; animation-delay: -4s; }

  /* ---------- marquee ---------- */
  .mq-sec { position: relative; padding: 56px 0 40px; text-align: center; }
  .mq-l { color: var(--faint); margin-bottom: 26px; }
  .mq { overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 16%, #000 84%, transparent); mask-image: linear-gradient(90deg, transparent, #000 16%, #000 84%, transparent); }
  .mq-t { display: flex; width: max-content; animation: mq 40s linear infinite; }
  .mq:hover .mq-t { animation-play-state: paused; }
  .mq-g { display: flex; align-items: center; gap: 36px; padding-right: 36px; }
  .mq-g span { font-weight: 300; font-size: clamp(22px, 2.4vw, 30px); letter-spacing: -0.02em; white-space: nowrap; color: rgba(238, 240, 255, 0.38); transition: color 0.3s; }
  .mq-g span.hl, .mq-g span:hover { color: var(--fg); }
  .mq-g em { font-style: normal; color: rgba(185, 176, 255, 0.6); font-size: 15px; }

  /* ---------- stats ---------- */
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); }
  .stat { position: relative; display: grid; justify-items: center; gap: 12px; padding: 8px 20px; text-align: center; }
  .stat + .stat::before { content: ''; position: absolute; left: 0; top: -10px; bottom: -10px; width: 1px; background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.14), transparent); }
