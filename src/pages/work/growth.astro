---
import Base from '../../layouts/Base.astro';
import '../../styles/case.css';

// y = position of each section inside the 1400 x 9035 full-page image
const sections = [
  ['Hero', 'The promise + the product, above the fold', 0],
  ['Features', 'Four capabilities, shown not told', 1490],
  ['Built for growth', 'Sales & hiring, side by side', 2640],
  ['Progress', 'Proof in two big numbers', 3906],
  ['Integrations', 'An orbit of the tools teams already use', 4630],
  ['Pricing', 'Three tiers, the middle one highlighted', 5330],
  ['Testimonials', 'Faces, quotes and logos', 6345],
  ['CTA & FAQ', 'Remove the last doubts', 7250],
];
const highlights = [
  ['growth-features', 'Features as live UI', 'Each feature card shows a slice of the real product — a chart, an insight, a reporting view — so the value is visible before it’s read.'],
  ['growth-pricing', 'Pricing that guides the choice', 'Three tiers with the Pro plan lifted, outlined in blue and labelled — the eye lands on it first.'],
  ['growth-proof', 'Proof with faces', 'A video testimonial next to written quotes and company logos turns claims into trust.'],
];
---
<Base title="Growth — SaaS landing page · Abdul Rahman" description="A business-growth SaaS landing page designed by Abdul Rahman Mohammad." accent="61, 91, 255" image="/work/cover-growth.webp">
  <section class="c-hero">
    <div class="blob one"></div>
    <div class="wrap">
      <a class="back" href="/#work">← All work</a>
      <div class="c-head">
        <div class="pills" data-reveal><span class="label">Landing page</span><span class="tag">SaaS</span><span class="tag">UI design</span></div>
        <div class="c-row">
          <h1 class="c-title grad split">Growth</h1>
          <p class="c-sub acc" data-reveal style="--d:300;max-width:520px">A landing page that makes business growth feel simple.</p>
        </div>
        <dl class="meta" data-reveal style="--d:450">
          <div><dt>Type</dt><dd>SaaS landing page</dd></div>
          <div><dt>Role</dt><dd>UI/UX Designer</dd></div>
          <div><dt>Scope</dt><dd>10 sections · desktop</dd></div>
          <div><dt>Tools</dt><dd>Figma</dd></div>
        </dl>
      </div>
      <div class="blob two"></div>
      <figure class="cover" data-reveal style="--d:200"><img src="/work/growth-hero.webp" alt="Growth landing page on a laptop" width="1400" height="1050" fetchpriority="high" /></figure>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <p class="eyebrow" data-reveal>The brief</p>
      <div class="tldr">
        <div data-reveal><span class="num">01</span><h3>Goal</h3><p>Show a growth platform’s value in seconds — sales insights, hiring and progress in one product.</p></div>
        <div data-reveal style="--d:120"><span class="num">02</span><h3>Audience</h3><p>Founders and team leads comparing tools, who scan before they read.</p></div>
        <div data-reveal style="--d:240"><span class="num hl">03</span><h3>Approach</h3><p>Lead with the real product UI, one electric-blue accent, and proof — numbers, logos, testimonials — at every scroll.</p></div>
      </div>
    </div>
  </section>

  <section class="sec full-sec">
    <div class="blob" style="--o:.16;width:900px;height:700px;right:-200px;top:30%"></div>
    <div class="wrap full-grid">
      <div class="full-copy">
        <p class="eyebrow" data-reveal>The full page</p>
        <h2 class="h2 grad" data-reveal>Ten sections, one story.</h2>
        <p class="lead" data-reveal>Each section answers the next question a visitor has — from “what is it?” to “how much?” to “can I trust it?”. Hover the page to scroll through it.</p>
        <ol class="marks">
          {sections.map(([t, d], i) => (
            <li data-reveal style={`--d:${i * 60}`}><span class="mono">{String(i + 1).padStart(2, '0')}</span><div><b>{t}</b><small>{d}</small></div></li>
          ))}
        </ol>
      </div>
      <div class="browser" data-reveal>
        <div class="bar"><i></i><i></i><i></i><span class="mono">growth.app</span></div>
        <div class="viewport" data-autoscroll tabindex="0" aria-label="Full landing page preview — hover or focus to scroll">
          <img src="/work/growth-full.webp" alt="The full Growth landing page, top to bottom" loading="lazy" width="1400" height="9035" />
        </div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="show-head">
        <p class="eyebrow" data-reveal>Design highlights</p>
        <h2 class="grad" data-reveal>The details that do the selling</h2>
      </div>
      <div class="hl-list">
        {highlights.map(([img, t, d], i) => (
          <div class={`hl ${i % 2 ? 'flip' : ''}`}>
            <figure class="fig" data-reveal><img src={`/work/${img}.webp`} alt={t} loading="lazy" /></figure>
            <div data-reveal style="--d:150"><span class="num hl">{`0${i + 1}`}</span><h3>{t}</h3><p>{d}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec next-wrap">
    <div class="seam"></div>
    <div class="wrap">
      <p class="eyebrow">Next project</p>
      <a class="next card spot" href="/work/mushaf-eqraa" style="--na:47,211,154;--ca:47,211,154;--nbg:#0d2019;background:linear-gradient(180deg,#0f2a22,#08090f);border-color:rgba(47,211,154,.4)">
        <div class="n-copy" style="text-align:left">
          <span class="mono">Web platform · Case study</span>
          <h3 class="grad">Mushaf Eqraa</h3>
          <p>A calm Quran platform — research, flows, UI and design QA.</p>
          <span class="btn btn-p" style="justify-self:start">Read the case study <span class="arr">→</span></span>
        </div>
        <div class="n-img"><img src="/work/cover-mushaf.webp" alt="" loading="lazy" /></div>
      </a>
    </div>
  </section>
</Base>

<style>
  .full-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 64px; align-items: start; }
  .full-copy { position: sticky; top: 120px; display: grid; gap: 20px; }
  .marks { display: grid; gap: 4px; margin-top: 12px; }
  .marks li { display: flex; gap: 16px; align-items: center; padding: 12px 0; border-top: 1px solid rgba(255, 255, 255, 0.08); }
  .marks .mono { display: grid; place-items: center; flex: none; width: 34px; height: 34px; border-radius: 50%; font-size: 12px; color: var(--muted); background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.14); }
  .marks li:first-child .mono { color: #05060a; background: linear-gradient(180deg, #c9d3ff, #3d5bff); border-color: transparent; box-shadow: 0 0 16px rgba(61, 91, 255, 0.7); }
  .marks b { display: block; font-weight: 500; font-size: 16px; }
  .marks small { font-size: 13.5px; color: var(--faint); }
  .browser { border-radius: 20px; overflow: hidden; background: #0b0c12; border: 1px solid rgba(169, 184, 255, 0.3); box-shadow: 0 0 80px rgba(61, 91, 255, 0.28), 0 40px 80px rgba(0, 0, 0, 0.6); }
  .bar { position: relative; display: flex; align-items: center; gap: 6px; height: 36px; padding-inline: 14px; background: #14151e; }
  .bar i { width: 10px; height: 10px; border-radius: 50%; background: #ff5f57; opacity: 0.8; }
  .bar i:nth-child(2) { background: #febc2e; }
  .bar i:nth-child(3) { background: #28c840; }
  .bar span { position: absolute; left: 50%; translate: -50% 0; font-size: 11px; color: var(--faint); }
  .viewport { height: min(900px, 78vh); overflow: hidden; cursor: ns-resize; }
  .viewport img { width: 100%; transition: transform 14s cubic-bezier(0.45, 0.05, 0.55, 0.95); }
  .viewport:hover img, .viewport:focus img { transition-duration: 14s; }
  .hl-list { display: grid; gap: 100px; }
  .hl { display: grid; grid-template-columns: 1.4fr 1fr; gap: 56px; align-items: center; }
  .hl.flip > :first-child { order: 2; }
  .hl h3 { margin-top: 10px; font-weight: 500; font-size: 30px; letter-spacing: -0.03em; line-height: 1.2; }
  .hl p { margin-top: 12px; font-weight: 300; font-size: 16.5px; line-height: 1.65; color: var(--muted); }
  .hl .num { font-size: 80px; }
  @media (max-width: 900px) {
    .full-grid, .hl { grid-template-columns: 1fr; gap: 32px; }
    .full-copy { position: static; }
    .hl.flip > :first-child { order: 0; }
    .viewport { height: 70vh; overflow-y: auto; cursor: auto; }
  }
</style>
